__pycache__/
.pytest_cache/
.ruff_cache/
.pytype/
.mypy_cache/
.venv/
docker/.env
dist/
build/
*.egg-info/
.coverage
htmlcov/
*.tar.gz
*.sha256
.DS_Store

# One-off smoke test workspace.
work/

# Tracked tile cache snapshot policy:
# - Keep README/.gitkeep and all .webp tiles in git
# - Ignore everything else under tile_cache (especially .png source tiles)
tile_cache/**
!tile_cache/.gitkeep
!tile_cache/README.md
!tile_cache/**/
!tile_cache/**/*.webp

# Generated release archives/checksums.
releases/*
!releases/.gitkeep
